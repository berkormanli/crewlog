# ─────────────────────────────────────────────────────────────────────────────
# CrewLog — production environment template (copy → .env.production, fill in).
#
# Used by docker-compose.production.yml. Coolify lets you paste these into the
# resource's "Environment Variables" tab instead of a literal .env file.
#
# DO NOT commit a populated copy. The .gitignore already excludes .env files.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=crewlog
POSTGRES_DB=crewlog
# Strong password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# ── Backend / JWT ───────────────────────────────────────────────────────────
# Generate two distinct secrets:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated list of browser origins allowed to call this API directly.
# Required for cross-origin deploys (SPA on one host, backend on another).
# Defaults to https://crewlog.pulsarsoftwares.com if unset — override here
# for additional origins (e.g. a staging SPA) or to disable browser access
# entirely (set to empty for server-to-server / curl only).
CORS_ORIGINS=https://crewlog.pulsarsoftwares.com

# ── Backend / uploads / rate limit ──────────────────────────────────────────
UPLOAD_MAX_BYTES=26214400
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
BACKDATE_WINDOW_DAYS=2
LOG_LEVEL=info

# ── Backend / integrations (optional, all off by default) ──────────────────
FIREFLIES_ENABLED=false
FIREFLIES_WEBHOOK_SECRET=
LLM_PROVIDER=stub
LLM_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────
# Host port the nginx container binds. Coolify/Traefik already owns 80+443
# on the host, so default to 8080 and let Coolify's "Domains" tab route your
# chosen hostname (e.g. crewlog.yourdomain) to this port.
FRONTEND_PORT=8080
# nginx upstream — host[:port] with NO scheme (the nginx `server` directive
# inside `upstream` blocks rejects URLs). Override only if you've renamed the
# backend service or exposed it on a different port.
BACKEND_UPSTREAM=backend:4000