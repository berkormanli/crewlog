NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://crewlog:crewlog@localhost:5432/crewlog

# JWT (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=26214400

# Optional SMTP (transactional email — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limit
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# Work-log backdate window (days). Workers can log time up to N days in the past.
BACKDATE_WINDOW_DAYS=2

# Integrations (leave FIREFLIES_ENABLED=false until configured)
FIREFLIES_ENABLED=false
FIREFLIES_WEBHOOK_SECRET=
# LLM provider for meeting action proposals ('stub' | 'openai' | 'anthropic')
LLM_PROVIDER=stub
LLM_API_KEY=
